# Backend Server
PORT=3001
MONGODB_URI=mongodb://localhost:27017/wallet-scanner
NODE_ENV=production

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email Configuration (Gmail example)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ALERT_EMAIL=your-alert-email@gmail.com

# Target Wallets (EDIT THESE)
TARGET_ETH_WALLET=0xYourEthWalletAddress
TARGET_BSC_WALLET=0xYourBscWalletAddress
TARGET_POLYGON_WALLET=0xYourPolygonWalletAddress
TARGET_ARBITRUM_WALLET=0xYourArbitrumWalletAddress
TARGET_OPTIMISM_WALLET=0xYourOptimismWalletAddress
TARGET_AVALANCHE_WALLET=0xYourAvalancheWalletAddress
TARGET_FANTOM_WALLET=0xYourFantomWalletAddress
TARGET_BASE_WALLET=0xYourBaseWalletAddress

# RPC Endpoints
ETH_RPC=https://eth.llamarpc.com
BSC_RPC=https://bsc-dataseed.binance.org
POLYGON_RPC=https://polygon-rpc.com
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC=https://mainnet.optimism.io
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
FANTOM_RPC=https://rpc.ftm.tools
BASE_RPC=https://mainnet.base.org

# Security
ADMIN_TOKEN=your_secure_admin_token_here
JWT_SECRET=your_jwt_secret_key
